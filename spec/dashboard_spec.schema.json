{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dashboard_spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "controls", "charts", "non_data_elements", "tabs"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["source_repo", "pinned_commit", "source_files",
                   "generator", "contract_issue"],
      "properties": {
        "source_repo": {"const": "looker-open-source/agent-analytics-block"},
        "pinned_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_files": {"type": "array", "items": {"type": "string"}},
        "generator": {"type": "string"},
        "contract_issue": {"type": "string"}
      }
    },
    "tabs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["source_dashboard", "name", "title"],
        "properties": {
          "source_dashboard": {"enum": ["usage", "performance"]},
          "name": {"type": "string"},
          "title": {"type": "string"}
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["id", "source_dashboard", "name", "field",
                     "default_value", "allow_multiple_values", "ui_config",
                     "placement"],
        "properties": {
          "id": {"type": "string"},
          "source_dashboard": {"enum": ["usage", "performance"]},
          "name": {"type": "string"},
          "field": {"type": "string"},
          "default_value": {"type": "string"},
          "allow_multiple_values": {"type": "boolean"},
          "ui_config": {"type": "object"},
          "placement": {"enum": [null, "page", "report"]}
        }
      }
    },
    "charts": {
      "type": "array",
      "minItems": 37,
      "maxItems": 37,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_dashboard", "source_tile", "page",
                     "looker_type", "ls_chart", "fields", "dimensions",
                     "measures", "pivots", "fill_fields", "tile_filters",
                     "sorts", "limit", "column_limit", "listen", "geometry",
                     "comparison_previous_period", "percentile", "style",
                     "oracle_query", "expected_fixture_result",
                     "screenshot_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_dashboard": {"enum": ["usage", "performance"]},
          "source_tile": {"type": "string", "minLength": 1},
          "page": {"type": "string", "minLength": 1},
          "looker_type": {"type": "string"},
          "ls_chart": {"enum": ["BAR", "COLUMN", "TIME_SERIES", "AREA",
                                 "SCORECARD", "TABLE", "PIE"]},
          "fields": {"type": "array", "minItems": 1,
                     "items": {"type": "string"}},
          "dimensions": {"type": "array", "items": {"type": "string"}},
          "measures": {"type": "array", "items": {"type": "string"}},
          "pivots": {"type": "array", "items": {"type": "string"}},
          "fill_fields": {"type": "array", "items": {"type": "string"}},
          "tile_filters": {"type": "object"},
          "sorts": {"type": "array", "items": {"type": "string"}},
          "limit": {"type": ["integer", "null"]},
          "column_limit": {"type": "integer"},
          "listen": {"type": "object",
                     "additionalProperties": {"type": "string"}},
          "geometry": {
            "type": "object",
            "required": ["row", "col", "width", "height"],
            "properties": {
              "row": {"type": "integer", "minimum": 0},
              "col": {"type": "integer", "minimum": 0},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            }
          },
          "comparison_previous_period": {"type": "boolean"},
          "percentile": {"type": "boolean"},
          "style": {"type": "object"},
          "oracle_query": {"type": ["string", "null"]},
          "expected_fixture_result": {"type": ["string", "null"]},
          "screenshot_id": {"type": ["string", "null"]}
        }
      }
    },
    "non_data_elements": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_dashboard", "page", "looker_type",
                     "ls_chart", "geometry", "payload"],
        "properties": {
          "id": {"type": "string"},
          "source_dashboard": {"enum": ["usage", "performance"]},
          "page": {"type": "string"},
          "looker_type": {"enum": ["text", "button"]},
          "ls_chart": {"enum": ["TEXT", "BUTTON"]},
          "geometry": {
            "type": "object",
            "required": ["row", "col", "width", "height"]
          },
          "payload": {"type": "object"}
        }
      }
    }
  }
}
